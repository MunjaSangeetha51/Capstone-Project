MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=skillproof
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=replace_with_your_password
APP_SECRET_KEY=replace_with_random_secret_at_least_32_characters
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
# Optional local sentence-transformers model name/path. First use may download model weights.
SKILLPROOF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
